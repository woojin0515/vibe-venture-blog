# Supabase 프로젝트 설정 > API 메뉴에서 확인할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 로컬 개발 시 접속 URL (구글 OAuth 리다이렉트에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 로컬 개발용 목업 데이터 사용 여부. true로 설정하면 메인 피드/상세 페이지가
# 실제 DB 대신 src/lib/mock/data.ts 의 목업 글 20개를 보여줍니다.
# 배포 환경(Vercel 등)에는 이 변수를 절대 설정하지 마세요 (미설정 시 항상 false).
USE_MOCK_DATA=true
